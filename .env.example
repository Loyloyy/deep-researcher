# ============================================================================
# deep-researcher — environment
# Copy to .env and fill in. .env is gitignored.
# ============================================================================

# ---- LiteLLM gateway (the single OpenAI-compatible endpoint the app talks to) ----
LITELLM_MASTER_KEY=sk-local-master-change-me
# GPT Researcher / LangChain talk OpenAI-compatible to the proxy:
OPENAI_BASE_URL=http://localhost:4000
OPENAI_API_KEY=sk-local-master-change-me   # MUST equal LITELLM_MASTER_KEY (app -> proxy auth)

# ---- Frontier models via OpenRouter (consumed by the LiteLLM proxy) ----
OPENROUTER_API_KEY=

# ---- Other provider backends (optional; only if you point an alias at them) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY_REAL=                 # only needed if embedding=openai:embedding
# VLLM_BASE_URL=http://localhost:8000/v1   # local vLLM/SGLang for a role and/or embeddings

# ---- Search ----
SEARX_URL=http://localhost:8080

# ---- Embeddings ----
# Default is local BGE-M3 in-process (see config/pipeline.yaml `embedding`); no key needed.
# To run BGE-M3 as a service instead, point EMBEDDING_BASE_URL at it (TEI/Infinity/vLLM).
# EMBEDDING_BASE_URL=http://localhost:8081/v1

# ---- Observability (optional; enable with: docker compose --profile obs up -d) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
