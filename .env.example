# ============================================================================
# deep-researcher — environment.   Copy to .env and fill in. .env is gitignored.
#
# This is the ONLY file you edit to choose models. Declare the 3 research models
# (+ judge) below; each can independently be an on-prem vLLM server or a frontier API.
# docker/litellm/config.yaml is a fixed template that wires these into the proxy.
# ============================================================================

# ---- LiteLLM gateway (the router; app talks OpenAI-compatible to it) ----
LITELLM_MASTER_KEY=sk-local-master-change-me
OPENAI_BASE_URL=http://localhost:4000
OPENAI_API_KEY=sk-local-master-change-me     # MUST equal LITELLM_MASTER_KEY (app -> proxy auth)

# ===========================================================================
# THE 3 MODELS (+ judge).  For each: MODEL (provider/id) + API_BASE + API_KEY.
#   on-prem vLLM : MODEL=hosted_vllm/<served-name>  API_BASE=http://host:8000/v1  API_KEY=dummy
#   OpenAI-compat: MODEL=openai/<name>              API_BASE=<url>                API_KEY=<key>
#   OpenRouter   : MODEL=openrouter/<prov>/<model>  API_BASE=https://openrouter.ai/api/v1  API_KEY=<or-key>
#   Anthropic    : MODEL=anthropic/<model>          API_BASE=https://api.anthropic.com  API_KEY=<key>
# Note: the litellm CONTAINER reaches host vLLM via host.docker.internal (compose extra_hosts).
# ===========================================================================

# strategic — planner
STRATEGIC_MODEL=hosted_vllm/qwen2.5-72b-instruct
STRATEGIC_API_BASE=http://host.docker.internal:8000/v1
STRATEGIC_API_KEY=dummy

# smart — report writer
SMART_MODEL=hosted_vllm/qwen2.5-72b-instruct
SMART_API_BASE=http://host.docker.internal:8000/v1
SMART_API_KEY=dummy

# fast — per-source summarizer (high volume → smaller/cheaper model)
FAST_MODEL=hosted_vllm/qwen2.5-7b-instruct
FAST_API_BASE=http://host.docker.internal:8001/v1
FAST_API_KEY=dummy

# judge — eval only; pick a DIFFERENT family than the generator
JUDGE_MODEL_NAME=hosted_vllm/llama3.1-8b-instruct
JUDGE_API_BASE=http://host.docker.internal:8002/v1
JUDGE_API_KEY=dummy

# ---- Search ----
SEARX_URL=http://localhost:8080

# ---- Local embedding + reranker models (optional; override config/pipeline.yaml) ----
# Put machine-specific/private paths HERE (gitignored) so git pulls never clobber them.
# If unset, pipeline.yaml's defaults (HuggingFace ids, auto-downloaded) are used.
# The embedding needs the huggingface: prefix; the reranker is a bare path.
# Requires mounting the path into the container — see docker/docker-compose.override.yml.
# DR_EMBEDDING=huggingface:/path/to/models/BAAI/bge-m3
# DR_RERANK_MODEL=/path/to/models/BAAI/bge-reranker-v2-m3

# ---- Optional observability (docker compose --profile obs up -d) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
