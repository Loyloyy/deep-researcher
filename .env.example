# ============================================================================
# deep-researcher — environment (LOCAL-FIRST: Ollama, no frontier keys needed)
# Copy to .env and fill in. .env is gitignored.
# ============================================================================

# ---- LiteLLM gateway (the single OpenAI-compatible endpoint the app talks to) ----
LITELLM_MASTER_KEY=sk-local-master-change-me
OPENAI_BASE_URL=http://localhost:4000
OPENAI_API_KEY=sk-local-master-change-me   # MUST equal LITELLM_MASTER_KEY (app -> proxy auth)

# ---- Local model server (Ollama on the host) ----
# The litellm CONTAINER reaches host Ollama via host.docker.internal (docker-compose extra_hosts).
# If you run the proxy WITHOUT docker, set this to http://localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Search ----
SEARX_URL=http://localhost:8080

# ---- Optional: switch any role to frontier later (config-only, in docker/litellm/config.yaml) ----
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# VLLM_BASE_URL=http://host.docker.internal:8000/v1

# ---- Optional observability (docker compose --profile obs up -d) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
